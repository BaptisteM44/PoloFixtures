# Database (Neon or Supabase)
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres"
DIRECT_URL="postgres://USER:PASSWORD@HOST:5432/postgres"

# Auth.js
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Public base url for QR codes
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Uploads
UPLOADS_ENABLED="true"

SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_[YOUR-SECRET-KEY]"

# Seed access codes (only needed when running prisma/seed.ts)
SEED_ADMIN_CODE="choose-a-strong-admin-code"
SEED_ORGA_CODE="choose-a-strong-orga-code"
SEED_REF_CODE="choose-a-strong-ref-code"
SEED_DEMO_EMAIL="demo@example.com"
SEED_DEMO_PASSWORD="choose-a-demo-password"

