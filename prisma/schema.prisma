generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  REF
  ORGA
  ADMIN
}

enum PlayerStatus {
  ACTIVE
  PENDING
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_SAY
}

// Diet is now stored as String[] on Player (values: OMNIVORE VEGETARIAN VEGAN GLUTEN_FREE)
// Allows cumulating e.g. VEGAN + GLUTEN_FREE on the same player.

enum TournamentStatus {
  UPCOMING
  LIVE
  COMPLETED
}

enum SaturdayFormat {
  ALL_DAY
  SPLIT_POOLS
  SWISS
  BERLIN_MIXED
  GRAZ
  MTP_OPEN
  KIOSQUE
  SPLIT_SWISS
  BIG_APPLE
}

enum SundayFormat {
  SE
  DE
  RR
  SWISS_SPLIT_SE
  SPLIT_SE
}

enum MatchPhase {
  POOL
  SWISS
  CROSS_POOL
  BRACKET
  FRIDAY_A
  FRIDAY_B
  SATURDAY_A
  SATURDAY_B
  SUNDAY_SWISS
  TOP32
  BOTTOM16
  GRAZ_RR
  GRAZ_REGROUP
  GRAZ_SE
  MTP_POOL_A
  MTP_POOL_B
  MTP_BARRAGE
  MTP_DE
  KIOSQUE_POOL
  KIOSQUE_TOP4
  KIOSQUE_BOTTOM12
  KIOSQUE_SE
  SWISS_A
  SWISS_B
  BIG_APPLE_RR
  BIG_APPLE_SWISS
  BIG_APPLE_PLACEMENT
  BIG_APPLE_SE
  STAGE // nouveau système pipeline : le match appartient à un Stage (stageId)
}

// ─── Pipeline de stages (refonte formats) ────────────────────────────────────
// Un tournoi "pipeline" = une suite ordonnée de Stages. Chaque stage est une
// brique générique (RR/Swiss/cross-pool/placement/SE/DE) configurée en JSON,
// reliée à la précédente par des règles d'entrée déclaratives.

enum StageType {
  RR          // poules round-robin (1..N groupes)
  SWISS       // rounds suisses (1 groupe ou groupes parallèles)
  CROSS_POOL  // confrontations croisées entre groupes selon le rang
  PLACEMENT   // duels directs par rang (1erA vs 1erB → seeds 1/2…)
  SE          // élimination simple (+ 3e place)
  DE          // double élimination (+ GF reset)
}

enum StageStatus {
  PENDING // en attente (l'étape précédente n'est pas terminée)
  ACTIVE  // en cours
  DONE    // terminée
  SKIPPED // supprimée/sautée en cours de tournoi (flexibilité live)
}

enum BracketSide {
  W  // Top bracket / standard SE: normal round
  L  // Top bracket / standard SE: 3rd place match / SPLIT_SE losers rounds
  G  // Top bracket / standard SE: final
  B  // Bottom bracket (SWISS_SPLIT_SE): normal round
  BG // Bottom bracket (SWISS_SPLIT_SE): final
  BL // Bottom bracket (SWISS_SPLIT_SE): 3rd place match
  R1 // SPLIT_SE: first round (all 16 teams)
  LG // SPLIT_SE: losers bracket final
  WL // SPLIT_SE: winners bracket 3rd place match
  LL // SPLIT_SE: losers bracket 3rd place match
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

enum MatchEventType {
  START
  PAUSE
  GOAL
  GOLDEN_GOAL
  PENALTY
  TIMEOUT
  TIME_ADJUST
  END
  SWAP_SIDES
}

enum PoolSession {
  MORNING
  AFTERNOON
}

enum MatchDay {
  FRI
  SAT
  SUN
}

enum ChatMode {
  OPEN
  ORG_ONLY
  DISABLED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SquadRole {
  CAPTAIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  SQUAD_INVITE
  SQUAD_INVITE_ACCEPTED
  SQUAD_INVITE_DECLINED
  SQUAD_ROLE_CHANGED
  DIRECT_MESSAGE_REQUEST
  DIRECT_MESSAGE_RECEIVED
  TEAM_REGISTERED        // inscription confirmée au tournoi
  TEAM_SELECTED          // tiré au sort → IN
  TEAM_WAITLISTED        // tiré au sort → liste d'attente (avec rang)
  BADGE_UNLOCKED         // badge débloqué
  TEAM_MESSAGE_RECEIVED  // nouveau message dans le chat d'équipe
  TASK_ASSIGNED          // tâche orga assignée
  TASK_DEADLINE_APPROACHING // deadline tâche orga proche
  CLUB_JOIN_REQUEST      // un joueur a rejoint le club (notif au manager)
  CLUB_SESSION           // nouvelle session ajoutée dans le club
  CLUB_SESSION_JOIN      // des joueurs se sont inscrits à une session
  CLUB_ANNOUNCEMENT      // nouvelle annonce dans le club
  COMMUNITY_STATUS_CHANGED // statut d'un item communauté a changé
  TEAM_FEE_CONFIRMED       // frais d'inscription d'équipe confirmés
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model AccessCode {
  id           String    @id @default(cuid())
  role         Role
  codeHash     String
  operatorId   String?
  tournamentId String?
  revokedAt    DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  operator  Operator? @relation(fields: [operatorId], references: [id])
  tournament Tournament? @relation(fields: [tournamentId], references: [id])

  @@index([role])
  @@index([operatorId])
  @@index([tournamentId])
}

model Operator {
  id            String   @id @default(cuid())
  name          String
  roles         Role[]
  tournamentIds String[]
  playerId      String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  player      Player?      @relation(fields: [playerId], references: [id])
  accessCodes AccessCode[]

  @@index([name])
}

model Tournament {
  id                      String           @id @default(cuid())
  slug                    String?          @unique
  name                    String
  continentCode           String
  region                  String?
  country                 String
  city                    String
  dateStart               DateTime
  dateEnd                 DateTime
  format                  String
  gameDurationMin         Int
  maxTeams                Int
  courtsCount             Int              @default(1)
  registrationFeePerTeam  Int
  registrationFeeCurrency String
  contactEmail            String
  registrationStart       DateTime?
  registrationEnd         DateTime?
  maxSoloPlayers          Int?      // null = pas de limite (ABC Chapeau)
  rushRegistration        Boolean   @default(false) // true = waitlist si complet, false = toutes inscriptions admises
  // Lieu principal (tout le tournoi)
  venueName               String?
  venueAddress            String?
  venueMapsUrl            String?
  // Accueil vendredi soir
  fridayWelcomeName       String?
  fridayWelcomeAddress    String?
  fridayWelcomeMapsUrl    String?
  // Terrain principal (samedi/dimanche)
  saturdayEventName       String?
  saturdayEventAddress    String?
  saturdayEventMapsUrl    String?
  // Soirée samedi
  saturdayEveningName     String?
  saturdayEveningAddress  String?
  saturdayEveningMapsUrl  String?
  otherNotes              String?
  links                   String[]
  bannerPath              String?
  streamYoutubeUrl        String?
  streamCourt1Url         String?
  streamCourt2Url         String?
  streamMultiplexUrl      String?
  chatMode                ChatMode         @default(DISABLED)
  infoTilesLayout         Json?
  saturdayFormat          SaturdayFormat
  poolCount               Int              @default(1)   // 1, 2, 3, 4 groupes
  crossPool               Boolean          @default(false) // dimanche matin cross-pool avant bracket
  swissRounds             Int              @default(5)
  poolRounds              Int?                              // null = unlimited (full round-robin)
  bracketSize             Int              @default(16)
  sundayFormat            SundayFormat
  scoringSystem           String           @default("3/1")  // "3/1" = V3 N1 D0, "1/0.5" = V1 N0.5 D0
  thirdPlaceMatch         Boolean          @default(false)  // SE only: add 3rd place match
  gfReset                 Boolean          @default(false)  // DE only: grand final bracket reset
  // Berlin Mixed format
  fridayRounds            Int              @default(5)
  saturdayRounds          Int              @default(5)
  sundayRounds            Int              @default(2)      // 1 or 2
  fridayGroupAStart       DateTime?        // Friday group A start time (morning)
  fridayGroupBStart       DateTime?        // Friday group B start time (afternoon)
  status                  TournamentStatus
  locked                  Boolean          @default(false)
  saturdayPoolAStart      DateTime?        // Pool A session start time (for match scheduling)
  saturdayPoolBStart      DateTime?        // Pool B session start time (for match scheduling)
  // MTP Open format
  mtpPoolAStart           DateTime?        // MTP: Pool A start (Sat morning)
  mtpPoolBStart           DateTime?        // MTP: Pool B start (Sat afternoon)
  mtpSundayStart          DateTime?        // MTP: Barrage + DE start (Sunday)
  testMode                Boolean          @default(false)        // Test tournament: excluded from badge calculations
  hidden                  Boolean          @default(false)        // Hidden from public tournament list (organizer-controlled)
  timezone                String?          // Fuseau IANA du lieu (ex: "Europe/Brussels") — tous les horaires affichés dans CE fuseau
  usesPipeline            Boolean          @default(false)        // true = nouveau système de stages (refonte formats)
  approved                Boolean          @default(false)
  submissionStatus        SubmissionStatus @default(PENDING)
  rejectionReason         String?
  // Hébergement
  accommodationAvailable  Boolean          @default(false)
  accommodationType       String?          // gymnase, camping, chez l'habitant…
  accommodationCapacity   Int?
  // Repas (JSON array of { day: 1|2|3, breakfast: bool, lunch: bool, dinner: bool })
  meals                   Json?
  // Kit list (ce qu'il faut apporter)
  kitList                 String?
  // Informations complémentaires
  additionalInfo          String?
  // FAQ (JSON array of { question: string, answer: string })
  faq                     Json?
  // Telegram group/channel link (t.me/...)
  telegramUrl             String?
  refToken                String?   @unique  // Token URL pour accès arbitre sans compte
  // Récap post-tournoi
  recapText               String?   // markdown
  photoFinishPath         String?   // URL upload photo finish
  photoFinishCredit       String?   // crédit photographe photo finish
  podiumNote              String?   // mention spéciale, MVP…
  recapAnecdote           String?   // anecdote / remerciement
  bannerCredit            String?   // crédit photographe
  mvpPlayerId             String?   // joueur·euse du tournoi
  mvpTitle                String?   // intitulé ex: "MVP", "Meilleur gardien"
  // Legacy meal booleans (kept for migration compatibility)
  breakfastProvided       Boolean          @default(false)
  lunchProvided           Boolean          @default(false)
  dinnerProvided          Boolean          @default(false)
  lat                     Float?
  lng                     Float?
  creatorId               String?
  externalRegistrationUrl String?
  hostClubId              String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  creator     Player?      @relation("CreatedTournaments", fields: [creatorId], references: [id])
  hostClub    Club?        @relation("HostedTournaments", fields: [hostClubId], references: [id])
  sponsors    Sponsor[]
  teams       Team[]
  pools       Pool[]
  matches     Match[]
  stages      Stage[]
  accessCodes AccessCode[]
  freeAgents     FreeAgent[]
  messages       TournamentMessage[]
  coOrganizers   TournamentOrganizer[]
  orgaTasks           OrgaTask[]
  orgaNotes           OrgaNote[]
  orgaLinks           OrgaLink[]
  followers           TournamentFollow[]
  accommodationHosts  AccommodationHost[]
  soloEntries     TournamentSoloEntry[]
  overlayChannels OverlayChannel[]
  registrationFields  RegistrationField[]

  @@index([continentCode])
  @@index([status])
  @@index([creatorId])
  @@index([hostClubId])
}

model Sponsor {
  id           String  @id @default(cuid())
  tournamentId String
  name         String
  logoPath     String?
  url          String?

  tournament Tournament @relation(fields: [tournamentId], references: [id])

  @@index([tournamentId])
}

model Team {
  id           String     @id @default(cuid())
  tournamentId String
  name         String
  city         String?
  country      String?
  color        String?
  seed         Int
  selected     Boolean    @default(true)
  guaranteed   Boolean    @default(false)
  waitlistPosition   Int?
  registrationNote   String?
  orgaNote           String?
  feePaid            Boolean   @default(false)
  // Berlin Mixed format
  fridayGroup        String?   // "A" | "B"
  saturdayGroup      String?   // "A" | "B"
  globalRank         Int?      // consolidated rank after each day

  playerALevel       String?   // "A" | "B" | "C" — format ABC
  playerBLevel       String?
  playerCLevel       String?

  tournament Tournament   @relation(fields: [tournamentId], references: [id])
  players    TeamPlayer[]
  poolTeams  PoolTeam[]
  matchesA   Match[]        @relation("TeamA")
  matchesB   Match[]        @relation("TeamB")
  stageEntries StageEntry[]
  messages   TeamMessage[]
  soloEntries TournamentSoloEntry[]
  registrationAnswers RegistrationAnswer[]

  @@index([tournamentId])
}

model Player {
  id        String       @id @default(cuid())
  slug      String?      @unique
  name      String
  country   String
  city      String?
  photoPath String?
  bio       String?
  startYear Int?
  hand        String?
  gender      Gender?
  showGender  Boolean  @default(false)
  diets       String[]  // OMNIVORE | VEGETARIAN | VEGAN | GLUTEN_FREE (cumulative)
  petAllergies  String?  // free text: cat, dog, etc.
  foodAllergies String?  // free text: nuts, lactose, etc.
  status           PlayerStatus @default(PENDING)
  suspendedReason  String?      // raison de la suspension (visible par l'admin)
  suspendedAt      DateTime?    // date de suspension
  badges       String[]
  pinnedBadges String[]  // badges shown on the card (max 5, subset of badges)
  clubLogoPath       String?
  emblemPosition     String?   @default("top-left")      // top-left | top-right | bottom-left | bottom-right
  teamLogoPath       String?
  teamLogoPosition   String?   @default("bottom-right")  // top-left | top-right | bottom-left | bottom-right
  createdAt DateTime     @default(now())

  teams              TeamPlayer[]
  soloEntries        TournamentSoloEntry[]
  account            PlayerAccount?
  operator           Operator?
  createdTournaments Tournament[]    @relation("CreatedTournaments")
  messages                TournamentMessage[]
  teamMessages            TeamMessage[]
  coOrganizedTournaments  TournamentOrganizer[]
  squads                  SquadMember[]
  sentInvitations         SquadInvitation[]     @relation("SentInvitations")
  receivedInvitations     SquadInvitation[]     @relation("ReceivedInvitations")
  squadMessages           SquadMessage[]
  notifications           Notification[]
  conversationsAsA        DirectConversation[]  @relation("ConversationPlayerA")
  conversationsAsB        DirectConversation[]  @relation("ConversationPlayerB")
  directMessages          DirectMessage[]
  freeAgentRegistrations  FreeAgent[]
  managedClubs            Club[]       @relation("ManagedClubs")
  clubMemberships         ClubMember[]
  clubAdminRoles          ClubAdmin[]
  createdClubSessions     ClubSession[]        @relation("CreatedSessions")
  clubSessionAttendances  ClubSessionAttendee[]
  clubMessages            ClubMessage[]
  clubSessionMessages     ClubSessionMessage[]
  borrowedEquipment       ClubEquipment[]      @relation("BorrowedEquipment")
  clubAnnouncements       ClubAnnouncement[]   @relation("ClubAnnouncements")
  orgaTaskAssignments     OrgaTaskAssignee[] @relation("OrgaTaskAssignments")
  createdOrgaTasks        OrgaTask[]   @relation("CreatedTasks")
  orgaNotes               OrgaNote[]   @relation("OrgaNotes")
  orgaLinks               OrgaLink[]   @relation("OrgaLinks")
  refereedMatches         Match[]      @relation("RefereedMatches")
  coRefereedMatches       Match[]      @relation("CoRefereedMatches")
  notificationPreference  NotificationPreference?
  tournamentFollows       TournamentFollow[]
  hostedAccommodations    AccommodationHost[] @relation("AccommodationHostPlayer")
  communityItems      CommunityItem[]
  communityVotes      CommunityVote[]
  communityReplies    CommunityReply[]
  communityReplyLikes CommunityReplyLike[]
  pushSubscriptions   PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([playerId])
}

model PlayerAccount {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  playerId         String    @unique
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  charterAcceptedAt DateTime?
  createdAt         DateTime  @default(now())

  player Player @relation(fields: [playerId], references: [id])
  loginDays LoginDay[]

  @@index([email])
}

model TeamPlayer {
  id                 String   @id @default(cuid())
  teamId             String
  playerId           String
  isCaptain          Boolean  @default(false)
  needsAccommodation Boolean  @default(false)
  registeredAt       DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id])
  player Player @relation(fields: [playerId], references: [id])
  accommodationGuest AccommodationGuest?
  registrationAnswers RegistrationAnswer[]

  @@unique([teamId, playerId])
}

model Pool {
  id           String       @id @default(cuid())
  tournamentId String
  name         String
  session      PoolSession?

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  teams      PoolTeam[]
  matches    Match[]

  @@index([tournamentId])
}

model PoolTeam {
  id     String @id @default(cuid())
  poolId String
  teamId String

  pool Pool @relation(fields: [poolId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([poolId, teamId])
}

model Match {
  id              String      @id @default(cuid())
  tournamentId    String
  phase           MatchPhase
  poolId          String?
  bracketSide     BracketSide?
  roundIndex      Int
  positionInRound Int         @default(0)
  courtName       String
  startAt         DateTime
  dayIndex        MatchDay
  poolSessionIndex Int?        // For pool matches: 0 = Pool A, 1 = Pool B, etc. Orga can launch each session independently
  status          MatchStatus @default(SCHEDULED)
  teamAId         String?
  teamBId         String?
  scoreA          Int         @default(0)
  scoreB          Int         @default(0)
  winnerTeamId    String?
  nextMatchWinId  String?
  nextSlotWin     String?
  nextMatchLoseId String?
  nextSlotLose    String?
  goldenGoal      Boolean     @default(false)
  refereePlayerId String?
  coRefereePlayerId String?
  // Pipeline (nouveau système) : rattachement à un Stage + groupe éventuel
  stageId         String?
  groupKey        String?     // "A", "B", … pour les stages multi-groupes

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  pool       Pool?      @relation(fields: [poolId], references: [id])
  stage      Stage?     @relation(fields: [stageId], references: [id])
  teamA      Team?      @relation("TeamA", fields: [teamAId], references: [id])
  teamB      Team?      @relation("TeamB", fields: [teamBId], references: [id])
  referee    Player?    @relation("RefereedMatches", fields: [refereePlayerId], references: [id])
  coReferee  Player?    @relation("CoRefereedMatches", fields: [coRefereePlayerId], references: [id])
  events     MatchEvent[]

  @@index([tournamentId])
  @@index([poolId])
  @@index([status])
  @@index([stageId])
}

model Stage {
  id           String      @id @default(cuid())
  tournamentId String
  order        Int         // position dans le pipeline (0-based)
  name         String      // "Poules", "Swiss dimanche", "Bracket final"…
  type         StageType
  config       Json        // options par type (groupes, rounds, 3e place, gfReset…) — validé par zod
  entryRules   Json        // règles d'entrée déclaratives (source, rangs, seeding) — validé par zod
  status       StageStatus @default(PENDING)
  startAt      DateTime?   // début planifié
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tournament Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches    Match[]
  entries    StageEntry[]

  @@index([tournamentId, order])
}

// Participants d'un stage, résolus au lancement depuis les entryRules.
model StageEntry {
  id       String  @id @default(cuid())
  stageId  String
  slot     Int     // seed 1-based au sein du stage (ou du groupe)
  groupKey String  @default("") // "A", "B", … ("" si stage mono-groupe)
  teamId   String?

  stage Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  team  Team? @relation(fields: [teamId], references: [id])

  @@unique([stageId, groupKey, slot])
  @@index([stageId])
}

model MatchEvent {
  id            String         @id @default(cuid())
  matchId       String
  type          MatchEventType
  createdAt     DateTime       @default(now())
  matchClockSec Int
  payload       Json

  match Match @relation(fields: [matchId], references: [id])

  @@index([matchId])
}

model KnownBikePoloCountry {
  id   String @id @default(cuid())
  code String @unique
  name String
}

model FreeAgent {
  id           String   @id @default(cuid())
  tournamentId String?
  playerId     String?  // linked Player account (if registered while logged in)
  name         String
  email        String
  city         String?
  country      String?
  notes        String?
  createdAt    DateTime @default(now())

  tournament Tournament? @relation(fields: [tournamentId], references: [id])
  player     Player?     @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([tournamentId])
  @@index([playerId])
}

model TeamMessage {
  id        String   @id @default(cuid())
  teamId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id])
  author Player @relation(fields: [authorId], references: [id])

  @@index([teamId])
  @@index([authorId])
}

model TournamentMessage {
  id                  String   @id @default(cuid())
  tournamentId        String
  authorId            String
  content             String
  context             String   @default("GENERAL")
  deletedByModeration Boolean  @default(false)
  createdAt           DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  author     Player     @relation(fields: [authorId], references: [id])

  @@index([tournamentId])
  @@index([authorId])
}

model TournamentOrganizer {
  id           String   @id @default(cuid())
  tournamentId String
  playerId     String
  /// 'ORGA' = co-organisateur | 'REF' = arbitre assigné au tournoi
  role         String   @default("ORGA")
  addedAt      DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  player     Player     @relation(fields: [playerId], references: [id])

  @@unique([tournamentId, playerId])
  @@index([tournamentId])
  @@index([playerId])
}

// ── Équipes permanentes (Squads) ──────────────────────────────────────────────

model Squad {
  id          String   @id @default(cuid())
  name        String
  logoPath    String?
  color       String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     SquadMember[]
  invitations SquadInvitation[]
  messages    SquadMessage[]

  @@index([name])
}

model SquadMember {
  id        String    @id @default(cuid())
  squadId   String
  playerId  String
  role      SquadRole @default(MEMBER)
  joinedAt  DateTime  @default(now())

  squad  Squad  @relation(fields: [squadId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([squadId, playerId])
  @@index([squadId])
  @@index([playerId])
}

model SquadInvitation {
  id              String           @id @default(cuid())
  squadId         String
  invitedPlayerId String
  invitedById     String
  status          InvitationStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  squad         Squad  @relation(fields: [squadId], references: [id], onDelete: Cascade)
  invitedPlayer Player @relation("ReceivedInvitations", fields: [invitedPlayerId], references: [id], onDelete: Cascade)
  invitedBy     Player @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([squadId, invitedPlayerId])
  @@index([squadId])
  @@index([invitedPlayerId])
}

model SquadMessage {
  id        String   @id @default(cuid())
  squadId   String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  squad  Squad  @relation(fields: [squadId], references: [id], onDelete: Cascade)
  author Player @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([squadId])
  @@index([authorId])
}

model Notification {
  id        String           @id @default(cuid())
  playerId  String
  type      NotificationType
  payload   Json             // { squadId, squadName, invitedById, invitedByName, ... }
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, read])
  @@index([playerId])
}

// ── Direct Messaging ──────────────────────────────────────────────────────────

model DirectConversation {
  id          String   @id @default(cuid())
  playerAId   String
  playerBId   String
  // Optional context (e.g. free agent registration that triggered the contact)
  freeAgentId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  playerA  Player         @relation("ConversationPlayerA", fields: [playerAId], references: [id], onDelete: Cascade)
  playerB  Player         @relation("ConversationPlayerB", fields: [playerBId], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([playerAId, playerBId])
  @@index([playerAId])
  @@index([playerBId])
}

model DirectMessage {
  id             String    @id @default(cuid())
  conversationId String
  authorId       String
  content        String
  read           Boolean   @default(false)
  createdAt      DateTime  @default(now())
  editedAt       DateTime?

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       Player             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([authorId])
}

// ── Clubs ─────────────────────────────────────────────────────────────────────

enum ClubMemberStatus {
  MEMBER
  PENDING_BY_MANAGER
  PENDING_BY_PLAYER
}

model Club {
  id              String   @id @default(cuid())
  name            String
  city            String
  country         String
  continentCode   String
  logoPath        String?
  description     String?
  website         String?
  instagram       String?
  trainingMapLink String?
  lat             Float?
  lng             Float?
  approved        Boolean  @default(false)
  managerId       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  manager       Player              @relation("ManagedClubs", fields: [managerId], references: [id])
  members       ClubMember[]
  admins        ClubAdmin[]
  sessions      ClubSession[]
  messages      ClubMessage[]
  venues        ClubVenue[]
  equipment     ClubEquipment[]
  announcements ClubAnnouncement[]
  hostedTournaments Tournament[]    @relation("HostedTournaments")

  @@index([continentCode])
  @@index([country])
  @@index([managerId])
}

model ClubEquipment {
  id          String   @id @default(cuid())
  clubId      String
  name        String
  category    String   // "bike", "mallet", "other"
  notes       String?
  borrowedBy  String?  // playerId si emprunté
  createdAt   DateTime @default(now())

  club       Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  borrower   Player? @relation("BorrowedEquipment", fields: [borrowedBy], references: [id])

  @@index([clubId])
}

model ClubMember {
  id       String           @id @default(cuid())
  clubId   String
  playerId String
  status   ClubMemberStatus @default(MEMBER)
  joinedAt DateTime         @default(now())

  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([clubId, playerId])
  @@index([clubId])
  @@index([playerId])
}

model ClubAdmin {
  id        String   @id @default(cuid())
  clubId    String
  playerId  String
  createdAt DateTime @default(now())

  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([clubId, playerId])
  @@index([clubId])
}

model ClubSession {
  id             String   @id @default(cuid())
  clubId         String
  venueId        String?
  title          String?
  date           DateTime
  duration       Int      @default(120)
  location       String?
  notes          String?
  recurring      Boolean  @default(false)
  recurrenceDay  Int?
  recurrenceTime String?
  color          String?  // hex color chosen by creator, e.g. "#ffa2af"
  createdById    String
  createdAt      DateTime @default(now())
  status         String   @default("ACTIVE")

  club      Club                  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  venue     ClubVenue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)
  createdBy Player                @relation("CreatedSessions", fields: [createdById], references: [id], onDelete: Cascade)
  attendees ClubSessionAttendee[]
  messages  ClubSessionMessage[]

  @@index([clubId])
  @@index([date])
}

model ClubSessionAttendee {
  id          String   @id @default(cuid())
  sessionId   String
  playerId    String
  status      String   @default("CONFIRMED")
  arrivalTime String?  // ex: "19:30"
  minPlayers  Int?     // vient si >= N joueurs
  createdAt   DateTime @default(now())

  session ClubSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, playerId])
  @@index([sessionId])
}

model ClubMessage {
  id        String   @id @default(cuid())
  clubId    String
  playerId  String
  content   String
  createdAt DateTime @default(now())

  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([clubId])
}

model ClubVenue {
  id        String   @id @default(cuid())
  clubId    String
  name      String
  address   String?
  mapLink   String?
  notes     String?
  color     String?   // hex color ex: "#3b82f6"
  createdAt DateTime @default(now())

  club     Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  sessions ClubSession[]

  @@index([clubId])
}

model ClubSessionMessage {
  id        String   @id @default(cuid())
  sessionId String
  playerId  String
  content   String
  createdAt DateTime @default(now())

  session ClubSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model ClubAnnouncement {
  id        String   @id @default(cuid())
  clubId    String
  authorId  String
  title     String
  content   String
  createdAt DateTime @default(now())

  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author Player @relation("ClubAnnouncements", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([clubId])
}

// ── Orga Dashboard ───────────────────────────────────────────────────────────

model OrgaTask {
  id           String       @id @default(cuid())
  tournamentId String
  title        String
  description  String?
  deadline     DateTime?
  completed    Boolean      @default(false)
  priority     TaskPriority @default(MEDIUM)
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tournament Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  createdBy  Player           @relation("CreatedTasks", fields: [createdById], references: [id])
  assignees  OrgaTaskAssignee[]

  @@index([tournamentId])
}

model OrgaTaskAssignee {
  id         String   @id @default(cuid())
  taskId     String
  playerId   String
  assignedAt DateTime @default(now())

  task   OrgaTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  player Player   @relation("OrgaTaskAssignments", fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([taskId, playerId])
  @@index([taskId])
  @@index([playerId])
}

model OrgaNote {
  id           String   @id @default(cuid())
  tournamentId String
  content      String
  authorId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  author     Player     @relation("OrgaNotes", fields: [authorId], references: [id])

  @@index([tournamentId])
}

model OrgaLink {
  id           String   @id @default(cuid())
  tournamentId String
  label        String
  url          String
  addedById    String
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  addedBy    Player     @relation("OrgaLinks", fields: [addedById], references: [id])

  @@index([tournamentId])
}

model NotificationPreference {
  id         String   @id @default(cuid())
  playerId   String   @unique
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  enabled    Boolean  @default(true)
  continents String[] @default([])
  countries  String[] @default([])
  notifyNewTournaments  Boolean @default(true)
  notifyFollowedClosing Boolean @default(true)
  notifySquadInvite     Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TournamentFollow {
  id           String     @id @default(cuid())
  playerId     String
  tournamentId String
  createdAt    DateTime   @default(now())
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  @@unique([playerId, tournamentId])
}

// ── Accommodation ─────────────────────────────────────────────────────────────

model AccommodationHost {
  id           String   @id @default(cuid())
  tournamentId String
  playerId     String?  // optional: registered player host
  name         String   // display name
  contact      String?  // email, telegram, phone… free text
  notes        String?  // orga-only notes
  createdAt    DateTime @default(now())

  tournament Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player?             @relation("AccommodationHostPlayer", fields: [playerId], references: [id], onDelete: SetNull)
  guests     AccommodationGuest[]

  @@index([tournamentId])
  @@index([playerId])
}

model AccommodationGuest {
  id           String  @id @default(cuid())
  hostId       String
  teamPlayerId String  @unique
  notes        String?

  host       AccommodationHost @relation(fields: [hostId], references: [id], onDelete: Cascade)
  teamPlayer TeamPlayer        @relation(fields: [teamPlayerId], references: [id], onDelete: Cascade)

  @@index([hostId])
}

model RoadmapItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("feature") // "feature" | "bug" | "improvement"
  priority    String   @default("normal")  // "critical" | "high" | "normal" | "low"
  status      String   @default("todo")    // "todo" | "in_progress" | "done"
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TournamentSoloEntry {
  id            String   @id @default(cuid())
  tournamentId  String
  playerId      String
  level         String   // "C"|"C+"|"B-"|"B"|"B+"|"A-"|"A"|"A+"
  teamId        String?  // rempli après le tirage
  waitlisted    Boolean  @default(false)
  createdAt     DateTime @default(now())

  tournament    Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player        Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team          Team?          @relation(fields: [teamId], references: [id])

  @@unique([tournamentId, playerId])
  @@index([tournamentId])
  @@index([playerId])
}

model LoginDay {
  id        String        @id @default(cuid())
  accountId String
  date      String        // "YYYY-MM-DD" en UTC
  loggedAt  DateTime      @default(now()) // timestamp du 1er login de la journée

  account   PlayerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
  @@index([accountId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Community / Labs
// ─────────────────────────────────────────────────────────────────────────────

model CommunityItem {
  id         String   @id @default(cuid())
  type       String   // "idea" | "bug" | "translation"
  title      String
  body       String
  authorId   String?
  authorName String?  // pour les posts anonymes
  status     String   @default("open") // open | thinking | in_progress | done | rejected
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author  Player?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  votes   CommunityVote[]
  replies CommunityReply[]
}

model CommunityVote {
  id        String   @id @default(cuid())
  itemId    String
  playerId  String?
  vote      String   // "up" | "meh" | "down"
  comment   String?  // obligatoire si vote = "meh"
  createdAt DateTime @default(now())

  item   CommunityItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  player Player?       @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([itemId, playerId])
}

model CommunityReply {
  id         String   @id @default(cuid())
  itemId     String
  authorId   String?
  authorName String?  // pour les posts anonymes
  body       String
  isKeyReply Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  item   CommunityItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author Player?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  likes  CommunityReplyLike[]
}

model CommunityReplyLike {
  id        String   @id @default(cuid())
  replyId   String
  playerId  String?
  createdAt DateTime @default(now())

  reply  CommunityReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  player Player?        @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([replyId, playerId])
}

model OverlayChannel {
  id           String  @id @default(cuid())
  slug         String  @unique
  label        String
  tournamentId String?
  court        String  @default("1")
  theme        String  @default("dark")
  activeCourt  String  @default("1")
  showChat     Boolean @default(false)

  // Toggles d'affichage
  showClock     Boolean @default(true)
  showScore     Boolean @default(true)
  showTeamNames Boolean @default(true)
  showEventFeed Boolean @default(true)
  showHeader    Boolean @default(true)

  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Custom Registration Fields
// ─────────────────────────────────────────────────────────────────────────────

enum RegistrationFieldTarget {
  PLAYER
  TEAM
  CAPTAIN
}

model RegistrationField {
  id           String                  @id @default(cuid())
  tournamentId String
  label        String
  required     Boolean                 @default(false)
  target       RegistrationFieldTarget @default(PLAYER)
  order        Int                     @default(0)
  createdAt    DateTime                @default(now())

  tournament Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  answers    RegistrationAnswer[]

  @@index([tournamentId])
}

model RegistrationAnswer {
  id           String  @id @default(cuid())
  fieldId      String
  teamPlayerId String?
  teamId       String?
  value        String

  field      RegistrationField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  teamPlayer TeamPlayer?       @relation(fields: [teamPlayerId], references: [id], onDelete: Cascade)
  team       Team?             @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([fieldId])
  @@index([teamPlayerId])
  @@index([teamId])
}
